<!-- Styles shared by the windows (main window, Event Editor), merged in their resources; the colors come from the
     theme (Themes.cs). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:PowerMIDI.Behaviors">
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <!-- Own template, with the colors of the Windows one under the mouse and pressed (light blue); disabled: the colors
         of the theme dimmed (the Windows one turns light grey whatever the theme). -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FFBEE6FD"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3C7FB1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FFC4E5F6"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2C628B"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- Hover / click: light background, so text turns black to stay readable. -->
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnLightTextBrush}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnLightTextBrush}"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Toggle buttons (mixer M / S, EFX channels): same rules, and black text when
       pressed (light background). State colors (red mute, green solo, blue fixed) take precedence. -->
  <Style TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnLightTextBrush}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnLightTextBrush}"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Drop-down lists, in the colors of the theme (the Windows ones stay light whatever the theme). Closed: the colors of
       the buttons, its arrow at the right; open: the same background, the item under the mouse and the selected one in
       the colors of the tabs. The button of a list (ComboToggleTemplate) is also used by the instrument list of the Mixer
       (InstrumentComboTemplate, MainWindow.xaml). -->
  <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
    <Border x:Name="Bd" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlLineBrush}" BorderThickness="1"
            SnapsToDevicePixels="True">
      <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{DynamicResource ControlMutedBrush}"
            Data="M0,0 L3.5,4 L7,0 Z"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ControlTextBrush}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlSelectedBrush}"/>
        <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ControlTextBrush}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <!-- The wheel over a closed list: previous / next item (a list with its own wheel command keeps it, see Wheel). -->
  <Style TargetType="ComboBox">
    <Setter Property="b:Wheel.ComboStep" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}"/>
    <Setter Property="Padding" Value="6,3,2,3"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="ItemsPanel">
      <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Grid.ColumnSpan="2" Style="{x:Null}" Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
            <ContentPresenter x:Name="Content" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <!-- Keyboard focus (Tab): the border in the grey of the muted text (as the search boxes). -->
            <Border x:Name="Focus" Grid.ColumnSpan="2" BorderBrush="{DynamicResource ControlMutedBrush}" BorderThickness="1"
                    IsHitTestVisible="False" Visibility="Collapsed"/>
            <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
              <Border Background="{DynamicResource ControlPopupBrush}" BorderBrush="{DynamicResource ControlPopupLineBrush}" BorderThickness="1"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer CanContentScroll="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Collapsed"/></Trigger>
            <!-- Disabled: dimmed with the theme colors, kept light otherwise (ControlDisabledOpacity, Themes.cs). -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource ControlDisabledOpacity}"/>
              <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource ControlMutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Items of the open lists: with the light controls, as in the Windows lists (selected: grey, framed; under the mouse
       or the keyboard: blue, framed); with the theme colors, those of the tabs, without frames. -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}"/>
    <Setter Property="Padding" Value="5,1"/>   <!-- 6,2 with the frame (1 px) -->
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <!-- No dotted frame of keyboard focus (arrow keys from the search box of the instrument list): the item is already
         highlighted. -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <!-- No scrolling of the list by the mouse moving onto a row cut at its bottom (see NoMouseScroll). -->
    <Setter Property="b:NoMouseScroll.IsEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlItemSelectedBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlItemSelectedLineBrush}"/>
            </Trigger>
            <!-- Highlighted (the list moves it with the mouse and the keyboard: one item at a time, also while the wheel
                 scrolls the list under a still mouse): the selected item keeps its look (it is highlighted when the
                 list opens), unless the mouse is on it. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsHighlighted" Value="True"/>
                <Condition Property="IsSelected" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlItemHoverBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlItemHoverLineBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsHighlighted" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlItemHoverBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlItemHoverLineBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ControlMutedBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Search boxes (Library tab, Event Editor, instrument list of the Mixer) in the colors of the drop-down lists
       (theme, or light with the light controls); the Windows ones stay white. -->
  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource ControlFieldBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLineBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ControlTextBrush}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
            <!-- Typing in it: the border in the grey of the muted text (of the theme, or of the light controls). -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFieldBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlMutedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ControlDisabledOpacity}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Lists with columns (playlist, Library tab, Event Editor): own template, the default one lights the border up under
       the mouse and with the focus. -->
  <Style x:Key="ThemedListView" TargetType="ListView">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="b:LastColumn.Track" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <!-- Rounded corners as the panels around (the header and the rows cut to them), the header without the margin
             of the Windows template (a strip of the list background at its left and right). -->
        <ControlTemplate TargetType="ListView">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
              <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False" b:RoundedClip.Radius="5"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                <ScrollViewer.Template>
                  <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <DockPanel Margin="{TemplateBinding Padding}">
                        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False">
                          <GridViewHeaderRowPresenter
                              Columns="{Binding TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                              ColumnHeaderContainerStyle="{Binding TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                              ColumnHeaderTemplate="{Binding TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                              ColumnHeaderTemplateSelector="{Binding TemplatedParent.View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                              ColumnHeaderStringFormat="{Binding TemplatedParent.View.ColumnHeaderStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                              AllowsColumnReorder="{Binding TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                              ColumnHeaderContextMenu="{Binding TemplatedParent.View.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                              ColumnHeaderToolTip="{Binding TemplatedParent.View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                      </DockPanel>
                      <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Cursor="Arrow"
                                 Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                 Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                      <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Cursor="Arrow"
                                 Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                 Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                  </ControlTemplate>
                </ScrollViewer.Template>
                <ItemsPresenter/>
              </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Their rows: hovered or selected in the colors of the theme. -->
  <Style x:Key="ThemedListViewItem" TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <!-- Own template: the hovered and the selected rows in the colors of the theme (the default one draws them light). -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="Bd" Background="Transparent" Padding="0,2" SnapsToDevicePixels="True">
            <GridViewRowPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="6,4"/>
    <!-- Own template: the column separators (resize grips) of the default one are white. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-4,0" Cursor="SizeWE"
                   BorderBrush="{DynamicResource LineBrush}">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent">
                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{TemplateBinding BorderBrush}"/>
                  </Border>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- The filler after the last column has no separator. -->
            <Trigger Property="Role" Value="Padding">
              <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <!-- Nor the last column (its separator would show against the rounded border, see LastColumn); it can still
                 be resized. -->
            <Trigger Property="b:LastColumn.IsLast" Value="True">
              <Setter TargetName="PART_HeaderGripper" Property="BorderBrush" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
