<Window x:Class="PowerMIDI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:PowerMIDI.Behaviors"
        xmlns:vm="clr-namespace:PowerMIDI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Title="PowerMIDI" Icon="PowerMIDI.ico" Width="1172" Height="620" MinWidth="1098" MinHeight="620"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource WindowTextBrush}" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp" Deactivated="OnDeactivated"
        Closing="OnClosing">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>   <!-- buttons, lists -->
      </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <!-- Instrument list of a channel: the drop-down lists of the theme (Styles.xaml), with a search box above the sounds
         (it filters them while typing; see ChannelViewModel.SearchText). -->
    <ControlTemplate x:Key="InstrumentComboTemplate" TargetType="ComboBox">
      <Grid SnapsToDevicePixels="True">
        <ToggleButton Style="{x:Null}" Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
        <!-- What the channel plays: piano keys for a sound, a drum for a drum kit (none while unused), in the color of the
             arrow; not with the light controls (InstrumentIconsVisibility, InstrumentTextMargin: Themes.cs). -->
        <Grid Visibility="{DynamicResource InstrumentIconsVisibility}" HorizontalAlignment="Left">
          <Viewbox x:Name="SoundIcon" IsHitTestVisible="False" Margin="5,0,0,0" Width="12" Height="12" HorizontalAlignment="Left"
                   VerticalAlignment="Center">
            <Canvas Width="12" Height="12">
              <!-- Three white keys (a frame and two lines) and two black keys. -->
              <Path Stroke="{DynamicResource ControlMutedBrush}" StrokeThickness="1.1" Data="M0.6,1.4 H11.4 V10.6 H0.6 Z M4.2,7 V10.6 M7.8,7 V10.6"/>
              <Path Fill="{DynamicResource ControlMutedBrush}" Data="M2.8,1.4 H5.6 V7 H2.8 Z M6.4,1.4 H9.2 V7 H6.4 Z"/>
            </Canvas>
          </Viewbox>
          <Viewbox x:Name="DrumIcon" IsHitTestVisible="False" Margin="5,0,0,0" Width="12" Height="12" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Visibility="Collapsed">
            <Canvas Width="12" Height="12">
              <!-- A drum: its head (an ellipse), its body and two sticks. -->
              <Path Stroke="{DynamicResource ControlMutedBrush}" StrokeThickness="1.2"
                    Data="M1.5,5 A4.5,1.8 0 1 0 10.5,5 A4.5,1.8 0 1 0 1.5,5 Z M1.5,5 L1.5,9.5 A4.5,1.8 0 0 0 10.5,9.5 L10.5,5 M3,1 L5.5,4.2 M9,1 L6.5,4.2"/>
            </Canvas>
          </Viewbox>
        </Grid>
        <ContentPresenter x:Name="Cp" IsHitTestVisible="False" Margin="{DynamicResource InstrumentTextMargin}" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
        <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
               Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
          <Border Background="{DynamicResource ControlPopupBrush}" BorderBrush="{DynamicResource ControlPopupLineBrush}" BorderThickness="1"
                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <DockPanel>
              <!-- Search box, as those of the Library tab and of the Event Editor, with its hint while empty. -->
              <Grid DockPanel.Dock="Top" Margin="3">
                <TextBox Style="{StaticResource SearchBox}" Padding="2,1" FontWeight="Normal" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search sounds (Enter: first match)"
                         IsVisibleChanged="OnInstrumentSearchVisible" PreviewKeyDown="OnInstrumentSearchKeyDown"/>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontWeight="Normal" Foreground="#FF8A8A8A">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                  <Run Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"/><Run Text="  Search instruments..."/>
                </TextBlock>
              </Grid>
              <ScrollViewer CanContentScroll="True">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
        <DataTrigger Binding="{Binding IsDrum}" Value="True">
          <Setter TargetName="SoundIcon" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="DrumIcon" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding InstrumentState}" Value="Unused">
          <Setter TargetName="SoundIcon" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="DrumIcon" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Cp" Property="Margin" Value="6,0,20,0"/>
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- Playlist rows (Styles.xaml); double click plays the track. -->
    <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}">
      <EventSetter Event="MouseDoubleClick" Handler="OnPlaylistItemDoubleClick"/>
    </Style>
    <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="36"/>
    </Style>
    <!-- Transport bar toggle buttons (shuffle, repeat, module display): option enabled = blue icon, the button itself drawn
         as the others (not pressed); hovered as the other buttons. The blue of the theme for text (FixedBrush), the dark
         one on the light background of a hovered button. -->
    <Style x:Key="TransportToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" SnapsToDevicePixels="True">
              <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#BEE6FD"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3C7FB1"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource FixedBrush}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource OnLightFixedBrush}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Dark tabs: wider headers, light text; selected tab is lighter. -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="MinWidth" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="{DynamicResource ButtonBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,0"
                    CornerRadius="4,4,0,0" Padding="20,5" Margin="0,0,3,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="12">

  <!-- Status line: under both panels, whose bottoms are thus aligned. -->
  <TextBlock DockPanel.Dock="Bottom" Margin="4,8,0,0" Foreground="{DynamicResource WindowTextMutedBrush}" FontSize="12"
             Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>

  <!-- Right panel: Mixer (16 channels), Effects (those of the current mode), Library and About tabs -->
  <Border DockPanel.Dock="Right" Width="508" Margin="12,0,0,0" Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
    <TabControl x:Name="RightTabs" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="4,8,4,4" Foreground="{DynamicResource TextBrush}"
                SelectedIndex="{Binding SelectedTab}">
    <TabItem Header="Mixer" DataContext="{Binding Mixer}" d:DataContext="{d:DesignInstance vm:MixerViewModel}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <!-- Reset, or Cancel in its place while an Append is in progress (Append, MainViewModel.MixerAppend.cs: two clicks,
             the settings changed in between written as events at the playback position; same state as the Append of the
             Event Editor). -->
        <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetCommand}" Margin="0"
                Padding="8,2" FontSize="12" ToolTip="Back to the file's settings">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsInsertPending, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button DockPanel.Dock="Right" Content="Cancel" Margin="0" Padding="8,2" FontSize="12"
                Command="{Binding DataContext.CancelInsertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.IsInsertPending, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Drops settings changed since Append was clicked"/>
        <ToggleButton DockPanel.Dock="Right" Content="Append" Margin="0,0,6,0" Padding="8,2" FontSize="12"
                      Command="{Binding DataContext.MixerAppendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      IsChecked="{Binding DataContext.IsInsertPending, RelativeSource={RelativeSource AncestorType=Window}}"
                      IsEnabled="{Binding DataContext.CanMixerAppend, RelativeSource={RelativeSource AncestorType=Window}}"
                      ToolTip="Click (playback paused), change settings, click again: written as events at start of beat"/>
        <!-- Icons in place of the labels (Sliders, Speed, Pitch): Segoe MDL2 Assets, named by their tooltips. -->
        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="5,0,8,0"
                   ToolTip="Sliders" AutomationProperties.Name="Sliders"/>
        <ComboBox DockPanel.Dock="Left" Width="180" SelectedIndex="{Binding ShownMenuIndex}"
                  ToolTip="Controller set by the sliders">
          <!-- Order of the menu: see MixerViewModel.MenuOrder -->
          <ComboBoxItem Content="Modulation (CC1)"
                        ToolTip="Modulation wheel (usually vibrato)"/>
          <ComboBoxItem Content="Volume (CC7)"/>
          <ComboBoxItem Content="Expression (CC11)"
                        ToolTip="Volume within the channel volume (dynamics)"/>
          <ComboBoxItem Content="Pan (CC10)"/>
          <ComboBoxItem Content="Reverb (CC91)"/>
          <ComboBoxItem Content="Chorus (CC93)"/>
          <ComboBoxItem Content="Variation / Delay (CC94)"
                        ToolTip="Variation send in XG, Delay send in GS"/>
          <ComboBoxItem Content="Attack Time (CC73)"
                        ToolTip="Envelope attack, relative to the original sound"/>
          <ComboBoxItem Content="Decay Time (CC75)"
                        ToolTip="Envelope decay, relative to the original sound"/>
          <ComboBoxItem Content="Release Time (CC72)"
                        ToolTip="Envelope release, relative to the original sound"/>
          <ComboBoxItem Content="Filter Cutoff (CC74)"
                        ToolTip="Filter cutoff (brightness), relative to the original sound"/>
          <ComboBoxItem Content="Filter Resonance (CC71)"
                        ToolTip="Filter resonance, relative to the original sound"/>
          <ComboBoxItem Content="Vibrato Rate (CC76)"
                        ToolTip="Vibrato rate, relative to the original sound"/>
          <ComboBoxItem Content="Vibrato Depth (CC77)"
                        ToolTip="Vibrato depth, relative to the original sound"/>
          <ComboBoxItem Content="Vibrato Delay (CC78)"
                        ToolTip="Delay before the vibrato, relative to the original sound"/>
          <ComboBoxItem Content="Portamento Time (CC5)"
                        ToolTip="Glide time between notes. Moving slider turns portamento on (CC65), 0 turns it off"/>
        </ComboBox>
        <!-- XG voice map (XG mode only): which version of the capital voices the module plays, see MixerViewModel. -->
        <ComboBox Width="120" HorizontalAlignment="Left" Margin="8,0,0,0" ItemsSource="{x:Static vm:MixerViewModel.VoiceMapNames}"
                  SelectedIndex="{Binding VoiceMapIndex}" Visibility="{Binding IsXg, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Voice map: version of XG base sounds (Auto: file choice)"/>
        <!-- GS default map (GS mode only): map of the sounds whose bank LSB is 0, see MixerViewModel. -->
        <ComboBox Width="120" HorizontalAlignment="Left" Margin="8,0,0,0" ItemsSource="{x:Static vm:MixerViewModel.GsDefaultMapNames}"
                  SelectedIndex="{Binding GsDefaultMapIndex}" Visibility="{Binding IsGs, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Default map: map of GS sounds without bank LSB (Auto: file choice)"/>
      </DockPanel>
      <!-- Speed and pitch of the playback (listening aids, see MainViewModel.Speed.cs). The tab's DataContext is the
           mixer: the bindings go to the window's. Right click: back to normal. -->
      <Grid DockPanel.Dock="Bottom" Margin="0,8,0,2"
            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="52"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="28"/>   <!-- as the M buttons of the channels: the value centered under them -->
        </Grid.ColumnDefinitions>
        <!-- Speed: fast forward, filled (two triangles), in the color of the text. -->
        <Viewbox Width="17" Height="12" VerticalAlignment="Center" Margin="3,0,8,0" ToolTip="Speed" AutomationProperties.Name="Speed">
          <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="M0,0 L8,6 L0,12 Z M8.5,0 L16.5,6 L8.5,12 Z"/>
        </Viewbox>
        <Slider Grid.Column="1" Minimum="50" Maximum="200" Value="{Binding Speed}" SmallChange="1" LargeChange="10"
                IsMoveToPointEnabled="True" VerticalAlignment="Center" b:Wheel.SliderStep="True"
                ToolTip="Playback speed (right click: 100 %)">
          <Slider.InputBindings>
            <MouseBinding MouseAction="RightClick" Command="{Binding ResetSpeedCommand}"/>
          </Slider.InputBindings>
        </Slider>
        <TextBlock Grid.Column="2" Text="{Binding SpeedText}" FontFamily="Consolas" TextAlignment="Right" Margin="0,0,6,0"/>
        <!-- Pitch: an arrow up and an arrow down, drawn bold, in the color of the text. -->
        <Viewbox Grid.Column="3" Width="14" Height="15" VerticalAlignment="Center" Margin="18,0,8,0" ToolTip="Pitch" AutomationProperties.Name="Pitch">
          <Path Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.9"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Data="M3.5,14 V1.5 M0.5,4.5 L3.5,1.5 L6.5,4.5 M10.5,1 V13.5 M7.5,10.5 L10.5,13.5 L13.5,10.5"/>
        </Viewbox>
        <Slider Grid.Column="4" Minimum="-6" Maximum="6" Value="{Binding Transpose}" SmallChange="1" LargeChange="6"
                IsMoveToPointEnabled="True" VerticalAlignment="Center" b:Wheel.SliderStep="True"
                ToolTip="Transposition in whole tones, drums excluded (right click: 0)">
          <Slider.InputBindings>
            <MouseBinding MouseAction="RightClick" Command="{Binding ResetTransposeCommand}"/>
          </Slider.InputBindings>
        </Slider>
        <TextBlock Grid.Column="5" Text="{Binding TransposeText}" FontFamily="Consolas" TextAlignment="Center"/>
      </Grid>
      <!-- One row per channel: number · LED · map · instrument · slider · value · M -->
      <ItemsControl ItemsSource="{Binding Channels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
            <Grid Height="26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="28"/>
              </Grid.ColumnDefinitions>

              <!-- Channel number: bold on a drum channel; click = keyboard mode on this channel (highlighted). -->
              <TextBlock Text="{Binding Number}" ToolTip="{Binding NumberToolTip}" FontFamily="Consolas" Cursor="Hand"
                         Padding="2,1" Margin="0,0,4,0" HorizontalAlignment="Left">
                <TextBlock.InputBindings>
                  <MouseBinding Gesture="LeftClick" Command="{Binding KeyboardCommand}"/>
                </TextBlock.InputBindings>
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDrum}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                      <DataTrigger Binding="{Binding IsKeyboard}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- Activity LED: orange while the channel is muted (its notes are played, not heard). -->
              <Ellipse Grid.Column="1" Width="9" Height="9" ToolTip="Activity (orange: muted)">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource InactiveBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource GreenBrush}"/></DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsActive}" Value="True"/>
                          <Condition Binding="{Binding IsMuted}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>

              <!-- Map of this channel: SC-8850 / SC-88Pro / SC-88 / SC-55 in GS, the MU2000 maps in XG (other modes: disabled). -->
              <ComboBox Grid.Column="2" ItemsSource="{Binding MapItems}" DisplayMemberPath="Text"
                        SelectedItem="{Binding SelectedMap}" IsEnabled="{Binding MapEnabled}" ToolTip="{Binding MapToolTip}"
                        b:Wheel.Command="{Binding MapWheelCommand}"
                        FontSize="11" Height="22" Margin="6,0,4,0" Padding="4,0,0,0"/>

              <!-- Instrument: the name when closed, all the sounds of the map when open (virtualized: up to 1262 sounds). -->
              <ComboBox Grid.Column="3" ItemsSource="{Binding InstrumentItems}" DisplayMemberPath="Text" TextSearch.TextPath="Text"
                        SelectedItem="{Binding SelectedInstrument}" IsDropDownOpen="{Binding IsListOpen}"
                        ToolTip="{Binding InstrumentToolTip}" b:Wheel.Command="{Binding InstrumentWheelCommand}"
                        MaxDropDownHeight="420" FontSize="12" Height="22" Margin="2,0,8,0">
                <!-- Fixed width: a virtualized list would follow the names on screen while scrolling. -->
                <ComboBox.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel Width="260"/></ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.Style>
                  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Template" Value="{StaticResource InstrumentComboTemplate}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding InstrumentState}" Value="Unused"><Setter Property="Foreground" Value="{DynamicResource ControlMutedBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding InstrumentState}" Value="Manual">
                        <Setter Property="Foreground" Value="{DynamicResource ControlFixedBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                      <!-- XG instrument set by a Multi Part SysEx of the file. -->
                      <DataTrigger Binding="{Binding IsSysExPatch}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ControlSysExBrush}"/></DataTrigger>
                      <!-- Sound not in the list of the mode (last: wins over the colors above). -->
                      <DataTrigger Binding="{Binding IsInstrumentMissing}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ControlMissingBrush}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ComboBox.Style>
              </ComboBox>

              <!-- Slider of the displayed controller: moving it fixes the value; right click: back to the file value. -->
              <Slider Grid.Column="4" Minimum="0" Maximum="127" SmallChange="1" LargeChange="8" IsMoveToPointEnabled="True"
                      VerticalAlignment="Center" Value="{Binding Value}" ToolTip="{Binding SliderToolTip}" b:Wheel.SliderStep="True">
                <Slider.InputBindings>
                  <MouseBinding MouseAction="RightClick" Command="{Binding ClearControllerCommand}"/>
                </Slider.InputBindings>
                <Slider.Style>
                  <Style TargetType="Slider">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Opacity" Value="0.4"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Slider.Style>
              </Slider>

              <!-- Value: blue and bold when fixed. -->
              <TextBlock Grid.Column="5" Text="{Binding ValueText}" FontFamily="Consolas" TextAlignment="Right" Margin="0,0,6,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFixed}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource FixedBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- Mute (click) / solo (right click): red when muted, green "S" when soloed. -->
              <ToggleButton Grid.Column="6" Content="{Binding MuteText}" IsChecked="{Binding IsMuted}" ToolTip="{Binding MuteToolTip}"
                            Width="24" Height="20" Padding="0" FontSize="11">
                <ToggleButton.InputBindings>
                  <MouseBinding MouseAction="RightClick" Command="{Binding SoloCommand}"/>
                </ToggleButton.InputBindings>
                <ToggleButton.Style>
                  <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMuted}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource MuteBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSolo}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ToggleButton.Style>
              </ToggleButton>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>
    </TabItem>
    <TabItem Header="Effects" DataContext="{Binding Effects}" d:DataContext="{d:DesignInstance vm:EffectsViewModel}">
    <TabItem.Resources>
      <!-- Widths of the label and value columns of a parameter row (blocks at full width). -->
      <GridLength x:Key="FxLabelWidth">180</GridLength>
      <GridLength x:Key="FxValueWidth">66</GridLength>

      <!-- Effect type, XG Variation connection or part: label · list · code of a type not in the list
           (no code: the list also takes the value column). -->
      <DataTemplate DataType="{x:Type vm:EffectListViewModel}">
        <Grid Height="26" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource FxLabelWidth}"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{DynamicResource FxValueWidth}"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedChoice}"
                    ToolTip="{Binding ToolTip}" b:Wheel.Command="{Binding WheelCommand}" MaxDropDownHeight="420" Height="22">
            <ComboBox.InputBindings>
              <MouseBinding MouseAction="RightClick" Command="{Binding ClearCommand}"/>
            </ComboBox.InputBindings>
            <ComboBox.Style>
              <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ValueText}" Value=""><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger>
                  <DataTrigger Binding="{Binding IsFixed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ControlFixedBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ComboBox.Style>
          </ComboBox>
          <!-- Hidden when empty: the list then takes its column, and a TextBlock would catch the clicks over it. -->
          <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="Consolas" TextAlignment="Right">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ValueText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DataTemplate>

      <!-- Numeric parameter: label · slider · value with unit (blue when fixed, gray when "auto").
           Minimum and Maximum come before Value, so that the value is never clipped by the default range. -->
      <DataTemplate DataType="{x:Type vm:EffectSliderViewModel}">
        <Grid Height="26" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource FxLabelWidth}"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{DynamicResource FxValueWidth}"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
          <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                  SmallChange="1" LargeChange="8" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                  ToolTip="{Binding ToolTip}" b:Wheel.SliderStep="True">
            <Slider.InputBindings>
              <MouseBinding MouseAction="RightClick" Command="{Binding ClearCommand}"/>
            </Slider.InputBindings>
          </Slider>
          <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="Consolas" TextAlignment="Right">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ValueState}" Value="Auto"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding ValueState}" Value="Fixed">
                    <Setter Property="Foreground" Value="{DynamicResource FixedBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DataTemplate>

      <!-- Heading above a group of parameters of a block (XG Part page: EQ): a line above (none for the first group),
           then its name in semi-bold. -->
      <DataTemplate DataType="{x:Type vm:EffectHeadingViewModel}">
        <Border BorderBrush="{DynamicResource LineBrush}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderThickness" Value="0,1,0,0"/>
              <Setter Property="Margin" Value="0,10,0,0"/>
              <Setter Property="Padding" Value="0,8,0,6"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasLine}" Value="False">
                  <Setter Property="BorderThickness" Value="0"/>
                  <Setter Property="Margin" Value="0,4,0,0"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="8,0,0,0"/>
        </Border>
      </DataTemplate>

      <!-- Row of buttons among the parameters (XG Variation: the parts, under Connection), like the channel buttons of a block. -->
      <DataTemplate DataType="{x:Type vm:EffectButtonRowViewModel}">
        <DockPanel Margin="0,4,0,4" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
          <TextBlock DockPanel.Dock="Top" Text="{Binding Label}" Margin="8,3,0,5"/>
          <ItemsControl ItemsSource="{Binding Buttons}" Margin="8,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </DockPanel>
      </DataTemplate>

      <!-- EFX on a channel: pressed = the part goes through the EFX; blue when fixed (dark if pressed, on a light background). -->
      <DataTemplate DataType="{x:Type vm:EffectChannelViewModel}">
        <ToggleButton Content="{Binding Number}" IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTip}"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                      Width="24" Height="22" Margin="0,0,4,4" FontSize="11" Padding="0">
          <ToggleButton.InputBindings>
            <MouseBinding MouseAction="RightClick" Command="{Binding ClearCommand}"/>
          </ToggleButton.InputBindings>
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFixed}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource FixedBrush}"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFixed}" Value="True"/>
                    <Condition Binding="{Binding IsChecked}" Value="True"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Foreground" Value="{DynamicResource OnLightFixedBrush}"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
        </ToggleButton>
      </DataTemplate>
      <!-- Block: title, the channel (part) buttons of the effects that have them, then the parameters. -->
      <DataTemplate DataType="{x:Type vm:EffectBlockViewModel}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Visibility="{Binding ShowTitle, Converter={StaticResource BoolToVisibility}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Margin" Value="0,12,0,4"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Margin" Value="0,2,0,4"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- Channel buttons: their label on its own line, so that they also fit in a half-width block. -->
          <DockPanel Margin="0,0,0,4" Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding ChannelsLabel}" Margin="8,3,0,5"/>
            <ToggleButton DockPanel.Dock="Right" Content="Follow" IsChecked="{Binding Follow}" VerticalAlignment="Top"
                          Padding="9,2" Height="22" Margin="0,0,0,4" FontSize="12" ToolTip="Note list follows notes played"
                          Visibility="{Binding HasFollow, Converter={StaticResource BoolToVisibility}}"/>
            <ToggleButton DockPanel.Dock="Right" Content="Audition" IsChecked="{Binding Audition}" VerticalAlignment="Top"
                          Padding="9,2" Height="22" Margin="0,0,6,4" FontSize="12" ToolTip="Plays note chosen or changed (on first channel of group)"
                          Visibility="{Binding HasFollow, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding Channels}" Margin="8,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </DockPanel>
          <DockPanel Margin="0,0,0,4" Visibility="{Binding HasParts, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding PartsLabel}" Margin="8,3,0,5"/>
            <ItemsControl ItemsSource="{Binding Parts}" Margin="8,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Params}"/>
        </StackPanel>
      </DataTemplate>
    </TabItem.Resources>
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <!-- Reset, or Cancel in its place while an Append is in progress (Append, MainViewModel.MixerAppend.cs: two clicks,
             the effects changed in between written as events at the playback position; same state as the Append of the
             Event Editor). -->
        <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetCommand}" Margin="0"
                Padding="8,2" FontSize="12" ToolTip="Back to the file's effects">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsInsertPending, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button DockPanel.Dock="Right" Content="Cancel" Margin="0" Padding="8,2" FontSize="12"
                Command="{Binding DataContext.CancelInsertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.IsInsertPending, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Drops settings changed since Append was clicked"/>
        <ToggleButton DockPanel.Dock="Right" Content="Append" Margin="0,0,6,0" Padding="8,2" FontSize="12"
                      Command="{Binding DataContext.MixerAppendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      IsChecked="{Binding DataContext.IsInsertPending, RelativeSource={RelativeSource AncestorType=Window}}"
                      IsEnabled="{Binding DataContext.CanMixerAppend, RelativeSource={RelativeSource AncestorType=Window}}"
                      ToolTip="Click (playback paused), change settings, click again: written as events at start of beat"/>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="5,0,0,0"/>
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Margin="5,0,0,6" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding InfoText}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <!-- GS and XG: tab strip of the blocks, one shown at a time at full width. -->
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" Margin="3,0,0,8" Focusable="False"
                    Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:EffectBlockViewModel}">
            <ToggleButton Content="{Binding TabTitle}" ToolTip="{Binding Title}"
                          IsChecked="{Binding IsSelected}" Padding="9,2" Margin="0,0,4,0" FontSize="12"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel IsEnabled="{Binding IsAvailable}" Margin="0,0,6,0">
          <!-- The block of the tab strip (GS, XG, GM2) or the MT-32 reverb alone, at full width. -->
          <ItemsControl ItemsSource="{Binding OtherBlocks}"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
    </TabItem>
    <!-- Library: the collections of library\library.db, by folder or searched; their files come from their zip, downloaded
         when asked for; double click or Enter plays a file (taken from the zip, added to the playlist), Backspace goes up,
         ☆ marks a favorite, the files are dragged to the playlist (see MainWindow.xaml.cs). -->
    <TabItem Header="Library" DataContext="{Binding Library}" d:DataContext="{d:DesignInstance vm:LibraryViewModel}">
    <DockPanel>
      <!-- Collection, Download (files not downloaded yet; Cancel while downloading, with its progress under the row) and
           Delete downloaded files. -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="7,4" Margin="6,0,0,0"
                Command="{Binding DeleteDownloadedCommand}" IsEnabled="{Binding IsDownloaded}"
                ToolTip="Delete downloaded files of collection (zip and files taken from it; downloaded again when needed)"/>
        <Button DockPanel.Dock="Right" Content="Download" Padding="10,2" Margin="6,0,0,0" Command="{Binding DownloadCommand}"
                Visibility="{Binding NeedsDownload, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding DownloadText}"/>
        <Button DockPanel.Dock="Right" Content="Cancel" Padding="10,2" Margin="6,0,0,0" Command="{Binding CancelDownloadCommand}"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" ToolTip="Stop download"/>
        <TextBlock Text="Collection:" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" DisplayMemberPath="Name" ToolTip="{Binding CollectionToolTip}"/>
      </DockPanel>
      <ProgressBar DockPanel.Dock="Top" Height="4" Margin="0,-2,0,6" Maximum="1" Value="{Binding DownloadProgress, Mode=OneWay}"
                   Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding DownloadText}"/>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" IsEnabled="{Binding HasCollection}">
        <ComboBox DockPanel.Dock="Right" Width="118" Margin="6,0,0,0" ItemsSource="{x:Static vm:LibraryViewModel.ShowNames}"
                  SelectedIndex="{Binding ShowIndex}" ToolTip="Files shown: all, favorites, played ones, with lyrics…"/>
        <ComboBox DockPanel.Dock="Right" Width="68" Margin="6,0,0,0" ItemsSource="{x:Static vm:LibraryViewModel.FormatNames}"
                  SelectedIndex="{Binding FormatIndex}" ToolTip="Files of one standard"/>
        <!-- Search box, with its hint while empty (over it, not hit by the mouse). -->
        <Grid>
          <TextBox Style="{StaticResource SearchBox}" Padding="2,1" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Search titles, folders and lyrics, in this folder and below (Esc: clear)">
            <TextBox.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#FF8A8A8A">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SearchText}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
            <Run Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"/><Run Text="  Search title..."/>
          </TextBlock>
        </Grid>
      </DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" IsEnabled="{Binding HasCollection}">
        <Button DockPanel.Dock="Left" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" Padding="6,3" Command="{Binding UpCommand}"
                ToolTip="Parent folder (Backspace)"/>
        <Button DockPanel.Dock="Left" Content="&#xE8B1;" FontFamily="Segoe MDL2 Assets" Padding="6,3" Command="{Binding RandomCommand}"
                ToolTip="Play random file of this folder and below (filters applied)"/>
        <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center" ClipToBounds="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding Prefix, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/><Hyperlink
                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     CommandParameter="{Binding Path}" Foreground="{DynamicResource AccentBrush}" TextDecorations="{x:Null}"><Run Text="{Binding Text, Mode=OneWay}"/></Hyperlink>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Margin="2,6,0,0" Text="{Binding CountText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
      <!-- Details of the row selected (LibraryViewModel: Details), between the list and the count. -->
      <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,5" Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4"
              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{Binding DetailTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextBrush}" ToolTip="{Binding DetailTitle}"/>
          <TextBlock Text="{Binding DetailInternalTitle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                     Foreground="{DynamicResource TextSoftBrush}" ToolTip="{Binding DetailInternalTitle}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DetailInternalTitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding DetailInfo}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                     Foreground="{DynamicResource TextSoftBrush}" ToolTip="{Binding DetailInfo}"/>
          <TextBlock Text="{Binding DetailMore}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                     Foreground="{DynamicResource TextMutedBrush}" ToolTip="{Binding DetailMore}"/>
        </StackPanel>
      </Border>
      <TextBlock DockPanel.Dock="Top" Margin="2,12,2,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSoftBrush}"
                 Visibility="{Binding HasNoLibrary, Converter={StaticResource BoolToVisibility}}"
                 Text="No library: library\library.db missing next to PowerMIDI.exe."/>
      <ListView x:Name="LibraryView" Style="{StaticResource ThemedListView}" ItemsSource="{Binding Rows}" SelectionMode="Extended"
                SelectedItem="{Binding SelectedRow}" SelectionChanged="OnLibrarySelectionChanged"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                GridViewColumnHeader.Click="OnLibraryHeaderClick" PreviewKeyDown="OnLibraryKeyDown"
                PreviewMouseLeftButtonDown="OnLibraryMouseDown" PreviewMouseMove="OnLibraryMouseMove">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}">
            <EventSetter Event="MouseDoubleClick" Handler="OnLibraryItemDoubleClick"/>
            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Unreadable}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Play" Command="{Binding PlayCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Add to playlist" Command="{Binding AddToPlaylistCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Favorite" Command="{Binding FavoriteCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="" Width="26">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSoftBrush}"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="LibraryTitleColumn" Header="File" Width="280">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="LibraryFolderColumn" Header="Folder" Width="0">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding FolderText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSoftBrush}"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Format" Width="60" DisplayMemberBinding="{Binding Format}"/>
            <GridViewColumn Header="Time" Width="50" DisplayMemberBinding="{Binding Time}"/>
            <GridViewColumn Header="★" Width="28">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Star}" Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                             MouseLeftButtonDown="OnLibraryStarClick" ToolTip="Favorite"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </DockPanel>
    </TabItem>
    <!-- About: the logo (same drawing as Icon.svg / PowerMIDI.ico, as vectors), the name and the version
         (set in MainWindow.xaml.cs from the version of the program). -->
    <TabItem Header="About">
    <DockPanel>
      <!-- Color theme (Themes.cs) and light controls, remembered in PowerMIDI.ini. -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
        <TextBlock Text="Theme" Margin="0,0,8,0"/>
        <ComboBox x:Name="ThemeBox" Width="110" SelectionChanged="OnThemeChanged" ToolTip="Colors of the window"/>
        <CheckBox x:Name="LightControlsBox" Content="Light controls" Margin="16,0,0,0" VerticalAlignment="Center"
                  Foreground="{DynamicResource TextBrush}" Click="OnLightControlsClick"
                  ToolTip="Drop-down lists of tabs drawn light, whatever the theme"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Viewbox Width="128" Height="128">
          <Canvas Width="24" Height="24">
            <Path Fill="#4089B6" Data="M5 1a4 4 0 0 0-4 4v14a4 4 0 0 0 4 4h14a4 4 0 0 0 4-4V5a4 4 0 0 0-4-4z"/>
            <Path Fill="White" Data="M52.104,0.249c-0.216-0.189-0.501-0.275-0.789-0.241l-31,4.011c-0.499,0.065-0.872,0.489-0.872,0.992v6.017v4.212v26.035C17.706,39.285,14.997,38,11.944,38c-5.247,0-9.5,3.781-9.5,8.444s4.253,8.444,9.5,8.444s9.5-3.781,9.5-8.444c0-0.332-0.027-0.658-0.069-0.981c0.04-0.108,0.069-0.221,0.069-0.343V16.118l29-3.753v18.909C48.706,29.285,45.997,28,42.944,28c-5.247,0-9.5,3.781-9.5,8.444s4.253,8.444,9.5,8.444s9.5-3.781,9.5-8.444c0-0.092-0.012-0.181-0.015-0.272c0.002-0.027,0.015-0.05,0.015-0.077V11.227V7.016V1C52.444,0.712,52.32,0.438,52.104,0.249z">
              <Path.RenderTransform>
                <TransformGroup><ScaleTransform ScaleX="0.24" ScaleY="0.24"/><TranslateTransform X="5.41" Y="5.41"/></TransformGroup>
              </Path.RenderTransform>
            </Path>
          </Canvas>
        </Viewbox>
        <TextBlock x:Name="AboutTitle" Text="PowerMIDI" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        <TextBlock Text="MIDI file player and editor" FontSize="15" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" HorizontalAlignment="Center" Margin="0,10,0,0">
          <Run Text="Powered by"/>
          <Hyperlink NavigateUri="https://melanchall.github.io/drywetmidi/" RequestNavigate="OnLinkNavigate"
                     Foreground="{DynamicResource AccentBrush}" ToolTip="https://melanchall.github.io/drywetmidi/">DryWetMIDI</Hyperlink>
        </TextBlock>
        <!-- The project page (source code, releases): the GitHub mark, in the text color of the theme (brighter under the
             mouse). -->
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0">
          <Hyperlink NavigateUri="https://github.com/bakuredo/PowerMIDI" RequestNavigate="OnLinkNavigate" TextDecorations="{x:Null}"
                     ToolTip="GitHub project (https://github.com/bakuredo/PowerMIDI)">
            <InlineUIContainer BaselineAlignment="Center">
              <Viewbox Width="28" Height="28" Cursor="Hand">
                <Path Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="Fill" Value="{DynamicResource TextSoftBrush}"/>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Fill" Value="{DynamicResource TextBrush}"/></Trigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Viewbox>
            </InlineUIContainer>
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </DockPanel>
    </TabItem>
    </TabControl>
  </Border>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Port and mode (no wheel step on the port: a change of port is not to be done by mistake) -->
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
      <!-- MIDI OUT: a MIDI socket (5-pin DIN seen from the front: the pins on an arc, the notch at the bottom), in the
           color of the text of the window; a click refreshes the port list (a module plugged in since). Dimmed under the
           mouse. -->
      <Button Margin="3,0,5,0" VerticalAlignment="Center" Cursor="Hand" Focusable="False" Command="{Binding RefreshPortsCommand}"
              ToolTip="MIDI OUT (click: refresh port list)" AutomationProperties.Name="Refresh port list">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="Cp"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cp" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Cp" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <Viewbox Width="18" Height="18">
          <Canvas Width="20" Height="20" Background="Transparent">
            <Ellipse Width="18" Height="18" Canvas.Left="1" Canvas.Top="1" StrokeThickness="1.5" Stroke="{DynamicResource WindowTextBrush}"/>
            <Path Fill="{DynamicResource WindowTextBrush}" Data="M8.6,16.6 L11.4,16.6 L11.4,19 L8.6,19 Z"/>
            <Ellipse Width="2.4" Height="2.4" Canvas.Left="3.8" Canvas.Top="8.8" Fill="{DynamicResource WindowTextBrush}"/>
            <Ellipse Width="2.4" Height="2.4" Canvas.Left="5.26" Canvas.Top="5.26" Fill="{DynamicResource WindowTextBrush}"/>
            <Ellipse Width="2.4" Height="2.4" Canvas.Left="8.8" Canvas.Top="3.8" Fill="{DynamicResource WindowTextBrush}"/>
            <Ellipse Width="2.4" Height="2.4" Canvas.Left="12.34" Canvas.Top="5.26" Fill="{DynamicResource WindowTextBrush}"/>
            <Ellipse Width="2.4" Height="2.4" Canvas.Left="13.8" Canvas.Top="8.8" Fill="{DynamicResource WindowTextBrush}"/>
          </Canvas>
        </Viewbox>
      </Button>
      <ComboBox Width="260" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" b:Wheel.ComboStep="False"
                AutomationProperties.Name="MIDI OUT"/>
      <!-- Mode, right after the port (no label: its tooltip says what it is). -->
      <ComboBox Width="120" Margin="6,0,0,0" SelectedValuePath="Content" SelectedValue="{Binding SelectedMode}"
                ToolTip="Mode: Auto follows file; other mode forced on it (SysEx of other modes ignored)">
        <ComboBoxItem Content="Auto"/>
        <ComboBoxItem Content="GS"/>
        <ComboBoxItem Content="XG"/>
        <ComboBoxItem Content="GM"/>
        <ComboBoxItem Content="GM2"/>
        <ComboBoxItem Content="MT-32"
                      ToolTip="Roland MT-32 / CM-32L"/>
      </ComboBox>
    </DockPanel>

    <!-- Playlist: double click (see the ListViewItem style) or Enter plays the track, Del removes the selected tracks;
         the selected tracks are moved by drag and drop in the list, or Ctrl+Up / Ctrl+Down (see MainWindow.xaml.cs). -->
    <ListView x:Name="PlaylistView" Grid.Row="1" Style="{StaticResource ThemedListView}"
              SelectionMode="Extended" ItemsSource="{Binding Playlist}" AllowDrop="True"
              SelectedItem="{Binding SelectedTrack}" SelectionChanged="OnPlaylistSelectionChanged"
              PreviewMouseLeftButtonDown="OnPlaylistMouseDown" PreviewMouseMove="OnPlaylistMouseMove"
              PreviewMouseLeftButtonUp="OnPlaylistMouseUp" DragOver="OnPlaylistDragOver" Drop="OnPlaylistDrop"
              PreviewKeyDown="OnPlaylistKeyDown" ScrollViewer.ScrollChanged="OnPlaylistScrollChanged"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.InputBindings>
        <KeyBinding Key="Return" Command="{Binding PlaySelectedCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=PlaylistView}"/>
      </ListView.InputBindings>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="" Width="28" DisplayMemberBinding="{Binding Playing}"/>
          <GridViewColumn Header="#" Width="44" DisplayMemberBinding="{Binding Index}"/>
          <!-- Width: the space the other columns leave (OnPlaylistScrollChanged), so that no horizontal scroll bar is needed. -->
          <GridViewColumn x:Name="PlaylistFileColumn" Header="File" Width="360" DisplayMemberBinding="{Binding Name}"/>
          <GridViewColumn Header="Format" Width="80" DisplayMemberBinding="{Binding Standard}"/>
          <GridViewColumn Header="Duration" Width="80" DisplayMemberBinding="{Binding Duration}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <!-- Playlist management -->
    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,12">
      <Button Content="Add files…" Command="{Binding AddFilesCommand}"/>
      <Button Content="Add folder…" Command="{Binding AddFolderCommand}"/>
      <Button Content="Remove" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItems, ElementName=PlaylistView}"/>
      <Button Content="Clear" Command="{Binding ClearCommand}"/>
      <Button Content="Save MIDI file…" Command="{Binding SaveCommand}"
              ToolTip="Saves the track with its settings (right click: choose another file).">
        <Button.InputBindings>
          <MouseBinding Gesture="RightClick" Command="{Binding SaveAsCommand}"/>
        </Button.InputBindings>
      </Button>
    </WrapPanel>

    <!-- Current track -->
    <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" TextElement.Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="6" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <!-- Badge of the standard, in its color. -->
          <Border DockPanel.Dock="Left" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource InactiveBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentStandard}" Value="GS"><Setter Property="Background" Value="#B33A3A"/></DataTrigger>
                  <DataTrigger Binding="{Binding CurrentStandard}" Value="XG"><Setter Property="Background" Value="#2F6DB5"/></DataTrigger>
                  <DataTrigger Binding="{Binding CurrentStandard}" Value="GM"><Setter Property="Background" Value="#4A7D3A"/></DataTrigger>
                  <DataTrigger Binding="{Binding CurrentStandard}" Value="GM2"><Setter Property="Background" Value="#3A7D72"/></DataTrigger>
                  <DataTrigger Binding="{Binding CurrentStandard}" Value="MT-32"><Setter Property="Background" Value="#9A6A2A"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding CurrentStandard}" FontWeight="SemiBold" Foreground="White"/>
          </Border>
          <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="14"/>
          <TextBlock Text="{Binding Title}" ToolTip="{Binding TitleToolTip}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <!-- Position: the jump happens when the mouse button is released. -->
        <Grid Grid.Row="2">
          <!-- Mouse down / up handlers: added in MainWindow.xaml.cs (they must also get the clicks the slider handles). -->
          <!-- Right click: the loop of the track (loopStart / loopEnd markers), at the bar clicked (MainViewModel.Loop.cs). -->
          <Slider x:Name="PositionBar" Margin="0,10" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}"
                  IsMoveToPointEnabled="True" IsEnabled="{Binding HasTrack}">
            <Slider.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding LoopStartMenuText}" Command="{Binding SetLoopStartCommand}"/>
                <MenuItem Header="{Binding LoopEndMenuText}" Command="{Binding SetLoopEndCommand}"/>
                <MenuItem Header="Remove loop" Command="{Binding RemoveLoopCommand}" IsEnabled="{Binding HasLoop}"/>
                <Separator/>
                <!-- Temporary loop: played instead of the track's, in memory only (MainViewModel.Loop.cs). -->
                <MenuItem Header="{Binding TempLoopStartMenuText}" Command="{Binding SetTempLoopStartCommand}"/>
                <MenuItem Header="{Binding TempLoopEndMenuText}" Command="{Binding SetTempLoopEndCommand}"/>
                <MenuItem Header="Remove temporary loop" Command="{Binding RemoveTempLoopCommand}" IsEnabled="{Binding HasTempLoop}"/>
              </ContextMenu>
            </Slider.ContextMenu>
          </Slider>
          <!-- Loop of a video game track (loopStart / loopEnd, [ / ], CC111): green markers above the bar, at its
               start and end. -->
          <Canvas x:Name="LoopCanvas" VerticalAlignment="Top" Height="9" Margin="0,1,0,0"
                  Visibility="{Binding HasLoop, Converter={StaticResource BoolToVisibility}}">
            <Canvas.Resources>
              <b:FractionToOffset x:Key="LoopOffset"/>
            </Canvas.Resources>
            <Path Data="M0,0 L8,0 L4,8 Z" Fill="{DynamicResource GreenBrush}" ToolTip="{Binding LoopToolTip}">
              <Canvas.Left>
                <MultiBinding Converter="{StaticResource LoopOffset}">
                  <Binding Path="LoopStartFraction"/>
                  <Binding Path="ActualWidth" ElementName="LoopCanvas"/>
                </MultiBinding>
              </Canvas.Left>
            </Path>
            <Path Data="M0,0 L8,0 L4,8 Z" Fill="{DynamicResource GreenBrush}" ToolTip="{Binding LoopToolTip}">
              <Canvas.Left>
                <MultiBinding Converter="{StaticResource LoopOffset}">
                  <Binding Path="LoopEndFraction"/>
                  <Binding Path="ActualWidth" ElementName="LoopCanvas"/>
                </MultiBinding>
              </Canvas.Left>
            </Path>
          </Canvas>
          <!-- Temporary loop (right click on the bar): orange markers, over the green ones. -->
          <Canvas x:Name="TempLoopCanvas" VerticalAlignment="Top" Height="9" Margin="0,1,0,0"
                  Visibility="{Binding HasTempLoop, Converter={StaticResource BoolToVisibility}}">
            <Canvas.Resources>
              <b:FractionToOffset x:Key="TempLoopOffset"/>
            </Canvas.Resources>
            <Path Data="M0,0 L8,0 L4,8 Z" Fill="{DynamicResource WarningBrush}" ToolTip="{Binding TempLoopToolTip}">
              <Canvas.Left>
                <MultiBinding Converter="{StaticResource TempLoopOffset}">
                  <Binding Path="TempLoopStartFraction"/>
                  <Binding Path="ActualWidth" ElementName="TempLoopCanvas"/>
                </MultiBinding>
              </Canvas.Left>
            </Path>
            <Path Data="M0,0 L8,0 L4,8 Z" Fill="{DynamicResource WarningBrush}" ToolTip="{Binding TempLoopToolTip}">
              <Canvas.Left>
                <MultiBinding Converter="{StaticResource TempLoopOffset}">
                  <Binding Path="TempLoopEndFraction"/>
                  <Binding Path="ActualWidth" ElementName="TempLoopCanvas"/>
                </MultiBinding>
              </Canvas.Left>
            </Path>
          </Canvas>
        </Grid>
        <DockPanel Grid.Row="3">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <Button Style="{StaticResource Transport}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="Previous"/>
            <Button Style="{StaticResource Transport}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" ToolTip="Play / pause (Space)"/>
            <Button Style="{StaticResource Transport}" Content="&#xE71A;" Command="{Binding StopCommand}" ToolTip="Stop"/>
            <Button Style="{StaticResource Transport}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Next"/>
            <ToggleButton Style="{StaticResource TransportToggle}" Content="&#xE8B1;" IsChecked="{Binding Shuffle}"
                          Margin="12,0,6,0" ToolTip="Shuffle"/>
            <ToggleButton Style="{StaticResource TransportToggle}" Content="{Binding RepeatGlyph}"
                          IsChecked="{Binding IsRepeatOn, Mode=OneWay}" Command="{Binding RepeatCommand}"
                          ToolTip="{Binding RepeatToolTip}"/>
            <!-- Shows / hides the screen of the module (text and dot picture sent by the file, see above); released while the
                 file has sent nothing. -->
            <ToggleButton Style="{StaticResource TransportToggle}" Content="&#xE7F4;" Margin="6,0,0,0" IsChecked="{Binding DisplayButton}"
                          ToolTip="Module display: text and picture sent by the file"/>
            <!-- Event Editor window: the events of the track (see EventEditorViewModel). -->
            <Button Style="{StaticResource Transport}" Content="&#xE8FD;" Margin="6,0,0,0" Command="{Binding EventsCommand}"
                    ToolTip="Event list of track"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Slider Width="90" Minimum="0" Maximum="127" Value="{Binding MasterVolume}" b:Wheel.SliderStep="True" IsMoveToPointEnabled="True"
                    VerticalAlignment="Center" ToolTip="Master volume"/>
            <TextBlock Text="{Binding MasterVolumeText}" Width="28" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
          </StackPanel>
          <Grid/>
        </DockPanel>
        <!-- Screen of the module, as on the front of a Sound Canvas, centered between the title and the position bar, at a
             fixed size: the 16 × 16 dot picture (Sound Canvas, MU; all dots off for an MT-32) and the text (32 characters
             at most, centered) the file writes on it; otherwise the lyrics of a karaoke file, the part already sung
             brighter; shown when there is some (display button). -->
        <Border Grid.Row="1" HorizontalAlignment="Center" Width="320" Height="58" Margin="0,10,0,0" Background="#1F2A14"
                BorderBrush="#3D5226" BorderThickness="1" CornerRadius="3" Padding="4"
                ToolTip="Display of the module (text and picture sent by file, or lyrics)"
                Visibility="{Binding DisplayShown, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Image DockPanel.Dock="Left" Source="{Binding DisplayDots}" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#A8E05F" xml:space="preserve"
                       VerticalAlignment="Center" Margin="8,0,6,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"><Run
                       Text="{Binding DisplaySung, Mode=OneWay}" Foreground="#F2FFD0" FontWeight="Bold"/><Run
                       Text="{Binding DisplayComing, Mode=OneWay}"/></TextBlock>
          </DockPanel>
        </Border>
      </Grid>
    </Border>

  </Grid>
  </DockPanel>
</Window>
