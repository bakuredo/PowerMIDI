<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBrush" Color="#C9C7C0"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#F4A641"/>
  <SolidColorBrush x:Key="LineBrush" Color="#3A3936"/>
  <SolidColorBrush x:Key="ButtonBrush" Color="#E2E0DA"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="#E38E28"/>
  <SolidColorBrush x:Key="TabHoverBrush" Color="#EFEDE7"/>
  <SolidColorBrush x:Key="TabSelectedBrush" Color="#F4A641"/>
  <SolidColorBrush x:Key="InactiveBrush" Color="#B79366"/>
  <!-- Text -->
  <SolidColorBrush x:Key="TextBrush" Color="#1F1408"/>
  <SolidColorBrush x:Key="TextSoftBrush" Color="#3B2910"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#54401F"/>
  <SolidColorBrush x:Key="WindowTextBrush" Color="#1F1408"/>
  <SolidColorBrush x:Key="WindowTextMutedBrush" Color="#54401F"/>
  <!-- States: value fixed by hand, activity / solo / loop, mute, insertion markers and keyboard channel, warnings -->
  <SolidColorBrush x:Key="FixedBrush" Color="#0B3F9C"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#17662A"/>
  <SolidColorBrush x:Key="MuteBrush" Color="#C0261C"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#7A1A10"/>
  <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#5A1E0A"/>
</ResourceDictionary>
