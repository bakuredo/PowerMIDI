<!-- Teal theme (default): the dark theme tinted cyber teal. Same keys as Dark.xaml; see Themes.cs. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBrush" Color="#101C20"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#18292E"/>
  <SolidColorBrush x:Key="LineBrush" Color="#31515A"/>
  <SolidColorBrush x:Key="ButtonBrush" Color="#21373D"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="#1B3036"/>
  <SolidColorBrush x:Key="TabHoverBrush" Color="#2A4850"/>
  <SolidColorBrush x:Key="TabSelectedBrush" Color="#35606A"/>
  <SolidColorBrush x:Key="InactiveBrush" Color="#2A4148"/>
  <!-- Text -->
  <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="TextSoftBrush" Color="#B8BBC4"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#8E929C"/>
  <!-- Text placed directly on the window (labels of the top bar, status line) -->
  <SolidColorBrush x:Key="WindowTextBrush" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="WindowTextMutedBrush" Color="#8E929C"/>
  <!-- States: value fixed by hand, activity / solo / loop, mute, insertion markers and keyboard channel, warnings -->
  <SolidColorBrush x:Key="FixedBrush" Color="#8AC8FF"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#5BD16A"/>
  <SolidColorBrush x:Key="MuteBrush" Color="#FF6B6B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#62D8CC"/>
  <SolidColorBrush x:Key="OnAccentTextBrush" Color="#0B2628"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#E0A050"/>
  <!-- On the light background of the hovered or pressed buttons, whatever the theme -->
  <SolidColorBrush x:Key="OnLightTextBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="OnLightFixedBrush" Color="#1F5FBF"/>
</ResourceDictionary>
