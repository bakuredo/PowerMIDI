<!-- Dark theme (the original colors of PowerMIDI). Same keys as Light.xaml; see Themes.cs. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBrush" Color="#1E1F24"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#25272D"/>
  <SolidColorBrush x:Key="LineBrush" Color="#3C3F49"/>
  <SolidColorBrush x:Key="ButtonBrush" Color="#2E3038"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="#2A2C33"/>
  <SolidColorBrush x:Key="TabHoverBrush" Color="#353844"/>
  <SolidColorBrush x:Key="TabSelectedBrush" Color="#3E4250"/>
  <SolidColorBrush x:Key="InactiveBrush" Color="#3A3D47"/>
  <!-- Text -->
  <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="TextSoftBrush" Color="#B8BBC4"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#8E929C"/>
  <!-- Text placed directly on the window (labels of the top bar, status line) -->
  <SolidColorBrush x:Key="WindowTextBrush" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="WindowTextMutedBrush" Color="#8E929C"/>
  <!-- States: value fixed by hand, activity / solo / loop, mute, insertion markers and keyboard channel, warnings -->
  <SolidColorBrush x:Key="FixedBrush" Color="#6FA8FF"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#5BD16A"/>
  <SolidColorBrush x:Key="MuteBrush" Color="#FF6B6B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#E0B050"/>
  <SolidColorBrush x:Key="OnAccentTextBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#E0A050"/>
  <!-- On the light surfaces Windows draws in both themes (lists, hovered or pressed buttons, selected rows) -->
  <SolidColorBrush x:Key="OnLightTextBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="OnLightDisabledBrush" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="OnLightFixedBrush" Color="#1F5FBF"/>
  <SolidColorBrush x:Key="OnLightMissingBrush" Color="#C62828"/>
  <SolidColorBrush x:Key="OnLightSysExBrush" Color="#2E7D32"/>
</ResourceDictionary>
