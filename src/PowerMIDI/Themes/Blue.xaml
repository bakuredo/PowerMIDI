<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBrush" Color="#141B2B"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#1A2438"/>
  <SolidColorBrush x:Key="LineBrush" Color="#2F4064"/>
  <SolidColorBrush x:Key="ButtonBrush" Color="#22304B"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="#1E2A42"/>
  <SolidColorBrush x:Key="TabHoverBrush" Color="#2A3A5A"/>
  <SolidColorBrush x:Key="TabSelectedBrush" Color="#33466C"/>
  <SolidColorBrush x:Key="InactiveBrush" Color="#2C3C5C"/>
  <!-- Text -->
  <SolidColorBrush x:Key="TextBrush" Color="#E4EAF5"/>
  <SolidColorBrush x:Key="TextSoftBrush" Color="#AEBBD3"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#8493B0"/>
  <SolidColorBrush x:Key="WindowTextBrush" Color="#E4EAF5"/>
  <SolidColorBrush x:Key="WindowTextMutedBrush" Color="#8493B0"/>
  <!-- States -->
  <SolidColorBrush x:Key="FixedBrush" Color="#7FE0FF"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#5BD16A"/>
  <SolidColorBrush x:Key="MuteBrush" Color="#FF6B6B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#FFB84D"/>
  <SolidColorBrush x:Key="OnAccentTextBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="ActivityBrush" Color="#FFB84D"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#E0A050"/>
  <!-- LCD Screen -->
  <SolidColorBrush x:Key="LcdBrush" Color="#0E1A33"/>
  <SolidColorBrush x:Key="LcdLineBrush" Color="#2A4472"/>
  <SolidColorBrush x:Key="LcdDotBrush" Color="#18294A"/>
  <SolidColorBrush x:Key="LcdTextBrush" Color="#6FB4FF"/>
  <SolidColorBrush x:Key="LcdSungBrush" Color="#E4F1FF"/>
</ResourceDictionary>
