<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBrush" Color="#261517"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#32191C"/>
  <SolidColorBrush x:Key="LineBrush" Color="#5E2F34"/>
  <SolidColorBrush x:Key="ButtonBrush" Color="#432228"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="#3A1D21"/>
  <SolidColorBrush x:Key="TabHoverBrush" Color="#522A30"/>
  <SolidColorBrush x:Key="TabSelectedBrush" Color="#63323A"/>
  <SolidColorBrush x:Key="InactiveBrush" Color="#54292F"/>
  <!-- Text -->
  <SolidColorBrush x:Key="TextBrush" Color="#F3E6E6"/>
  <SolidColorBrush x:Key="TextSoftBrush" Color="#D3B4B6"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#AE8A8D"/>
  <SolidColorBrush x:Key="WindowTextBrush" Color="#F3E6E6"/>
  <SolidColorBrush x:Key="WindowTextMutedBrush" Color="#AE8A8D"/>
  <!-- States -->
  <SolidColorBrush x:Key="FixedBrush" Color="#7FB6FF"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#5BD16A"/>
  <SolidColorBrush x:Key="MuteBrush" Color="#FF6B6B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#FF6B81"/>
  <SolidColorBrush x:Key="OnAccentTextBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="ActivityBrush" Color="#FF6B81"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#E0A050"/>
</ResourceDictionary>
