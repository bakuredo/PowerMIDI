<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBrush" Color="#14231A"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#1A2E22"/>
  <SolidColorBrush x:Key="LineBrush" Color="#2F5740"/>
  <SolidColorBrush x:Key="ButtonBrush" Color="#223D2D"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="#1E3528"/>
  <SolidColorBrush x:Key="TabHoverBrush" Color="#2A4B38"/>
  <SolidColorBrush x:Key="TabSelectedBrush" Color="#335B44"/>
  <SolidColorBrush x:Key="InactiveBrush" Color="#2A4A37"/>
  <!-- Text -->
  <SolidColorBrush x:Key="TextBrush" Color="#E4F2E8"/>
  <SolidColorBrush x:Key="TextSoftBrush" Color="#AFCDB8"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#86A792"/>
  <SolidColorBrush x:Key="WindowTextBrush" Color="#E4F2E8"/>
  <SolidColorBrush x:Key="WindowTextMutedBrush" Color="#86A792"/>
  <!-- States -->
  <SolidColorBrush x:Key="FixedBrush" Color="#7FB6FF"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#7CF08A"/>
  <SolidColorBrush x:Key="MuteBrush" Color="#FF6B6B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#A6E35A"/>
  <SolidColorBrush x:Key="OnAccentTextBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="ActivityBrush" Color="#A6E35A"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#E0A050"/>
  <!-- LCD Screen -->
  <SolidColorBrush x:Key="LcdBrush" Color="#1F2A14"/>
  <SolidColorBrush x:Key="LcdLineBrush" Color="#3D5226"/>
  <SolidColorBrush x:Key="LcdDotBrush" Color="#2C3A1D"/>
  <SolidColorBrush x:Key="LcdTextBrush" Color="#A8E05F"/>
  <SolidColorBrush x:Key="LcdSungBrush" Color="#F2FFD0"/>
</ResourceDictionary>
