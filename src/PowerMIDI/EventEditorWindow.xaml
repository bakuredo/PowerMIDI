<Window x:Class="PowerMIDI.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PowerMIDI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Title="{Binding Title}" Icon="PowerMIDI.ico" Width="1100" Height="720" MinWidth="900" MinHeight="420"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource WindowTextBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:EventEditorViewModel}">
  <!-- Event Editor (see EventEditorViewModel): the events of the current track, filtered; the row being played is
       selected while Follow is on; double click (or Enter) on a row: playback from there. Edit panel under the list:
       change the selected event, delete the selected ones (Delete), add one at the selected position, write the
       settings in blue (Mixer / Effects tabs) after the selected event (Append) or instead of it (Replace); Ctrl+Z / Ctrl+Y.
       A window of its own (not kept above the main one), closed with it. -->
  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
  </Window.InputBindings>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- An event replaced by a value fixed in the Mixer or Effects tab is in the accent color, as the value there; the tooltip says by what. -->
      <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}">
        <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsFixed}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="ToolTip" Value="{Binding FixedText}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- Hexadecimal and numbers in a fixed-width font. -->
      <DataTemplate x:Key="DataCell">
        <TextBlock Text="{Binding Data}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
      </DataTemplate>
      <DataTemplate x:Key="DescriptionCell">
        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"/>
      </DataTemplate>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
      <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,6,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}"/>
      </Style>
      <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Width" Value="70"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="12">
    <!-- Filters; the search box takes the space left (200 at most), so that the buttons stay whole in a narrow window. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <ComboBox Width="190" ItemsSource="{Binding Tracks}" SelectedIndex="{Binding TrackFilter}" ToolTip="Show events of one track"/>
      <ComboBox Width="120" Margin="8,0,0,0" ItemsSource="{Binding Channels}" SelectedIndex="{Binding ChannelFilter}"
                ToolTip="Show events of one channel (No channel: SysEx and meta events)"/>
      <ComboBox Width="140" Margin="8,0,0,0" ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindFilter}" ToolTip="Show one kind of events"/>
      <ToggleButton DockPanel.Dock="Right" Content="Follow" Padding="10,3" IsChecked="{Binding Follow}"
                    ToolTip="Select event being played"/>
      <ToggleButton DockPanel.Dock="Right" Content="Audition" Padding="10,3" Margin="0,0,6,0" IsChecked="{Binding Audition}"
                    ToolTip="Plays note selected"/>
      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource WindowTextMutedBrush}"
                 VerticalAlignment="Center" Margin="12,0,12,0"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="208"/></Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource SearchBox}" Margin="8,0,0,0" Padding="2,1" VerticalContentAlignment="Center"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search in type, data and description"/>
        <!-- Hint while empty (over the box, not hit by the mouse), as in the Library tab. -->
        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#FF8A8A8A"
                   TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"/><Run Text="  Search events..."/>
        </TextBlock>
      </Grid>
    </DockPanel>

    <!-- Edit panel: addition, deletion, Append / Replace, undo / redo, then the selected event (Apply or Enter, shown with a
         selection; a text or SysEx on the same line, up to Apply). -->
    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" TextElement.Foreground="{DynamicResource TextBrush}">
      <Border.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ApplyCommand}"/>
      </Border.InputBindings>
      <StackPanel>
        <DockPanel>
          <TextBlock Text="Add" VerticalAlignment="Center" MinWidth="110" Foreground="{DynamicResource TextSoftBrush}"/>
          <ComboBox Width="150" ItemsSource="{Binding NewKinds}" SelectedItem="{Binding AddKind}" ToolTip="Kind of event to add"/>
          <Button Content="Add" Margin="8,0,6,0" Command="{Binding AddCommand}"
                  ToolTip="Adds event at position of selected one (its track and channel)"/>
          <Button Content="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItems, ElementName=EventList}"
                  ToolTip="Deletes selected events (Delete)"/>
          <!-- Two clicks: the first one starts (pressed), the settings are changed in the Mixer / Effects tabs, the second
               one writes them as events, after the selected event or instead of the selected events; Cancel drops them. -->
          <ToggleButton Content="Append" Margin="12,0,6,0" Padding="10,3" Command="{Binding AppendCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=EventList}"
                        IsChecked="{Binding IsAppending}" IsEnabled="{Binding CanAppend}"
                        ToolTip="Click, change settings in Mixer / Effects tabs, click again: they are written below selected event"/>
          <ToggleButton Content="Replace" Padding="10,3" Command="{Binding ReplaceCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=EventList}"
                        IsChecked="{Binding IsReplacing}" IsEnabled="{Binding CanReplace}"
                        ToolTip="Click, change settings in Mixer / Effects tabs, click again: they replace selected events"/>
          <Button Content="Cancel" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                  Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Drops settings changed since Append / Replace was clicked"/>
          <Button DockPanel.Dock="Right" Content="Redo" Margin="0" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                  ToolTip="Redo (Ctrl+Y)"/>
          <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                  ToolTip="Undo (Ctrl+Z)"/>
          <!-- Messages (error, why the event cannot be changed, status): in the space left between the buttons, cut with
               an ellipsis if too long; whole in the tooltip. -->
          <TextBlock VerticalAlignment="Center" Margin="12,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MessagesToolTip}">
            <Run Text="{Binding Error, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}"/>
            <Run Text="{Binding NotEditable, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
            <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
          </TextBlock>
        </DockPanel>
        <DockPanel Margin="0,8,0,0">
          <TextBlock Text="{Binding EditKind}" FontWeight="SemiBold" MinWidth="110" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Visibility="{Binding HasChannel, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Channel" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding ChannelText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Width="40"
                     IsEnabled="{Binding CanApply}"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding CanApply}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                  <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- After the fields; with a text, at the right end (the text fills the line up to it). -->
          <Button Content="Apply" Margin="12,0,0,0" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"
                  Visibility="{Binding HasForm, Converter={StaticResource BoolToVisibility}}" ToolTip="Changes selected event (Enter)">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasText}" Value="True">
                    <Setter Property="DockPanel.Dock" Value="Right"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <DockPanel Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding TextLabel}" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="2,1" VerticalAlignment="Center"
                     FontFamily="Consolas" IsEnabled="{Binding CanApply}"/>
          </DockPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <ListView x:Name="EventList" Style="{StaticResource ThemedListView}" ItemsSource="{Binding View}"
              SelectedItem="{Binding SelectedRow}" SelectionMode="Extended"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListView.InputBindings>
        <KeyBinding Key="Return" Command="{Binding SeekCommand}" CommandParameter="{Binding SelectedItem, ElementName=EventList}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItems, ElementName=EventList}"/>
      </ListView.InputBindings>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Position" Width="80" DisplayMemberBinding="{Binding Position}"/>
          <GridViewColumn Header="Time" Width="80" DisplayMemberBinding="{Binding Time}"/>
          <GridViewColumn Header="Track" Width="50" DisplayMemberBinding="{Binding Track}"/>
          <GridViewColumn Header="Ch" Width="36" DisplayMemberBinding="{Binding Channel}"/>
          <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding Type}"/>
          <GridViewColumn Header="Data" Width="300" CellTemplate="{StaticResource DataCell}"/>
          <GridViewColumn Header="Description" Width="360" CellTemplate="{StaticResource DescriptionCell}"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
