<Project Sdk="Microsoft.NET.Sdk">

  <!-- Library Builder: builds the database of a collection of MIDI files, for the Library tab of PowerMIDI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PowerMIDI.LibraryBuilder</RootNamespace>
    <AssemblyName>PowerMIDI-LibraryBuilder</AssemblyName>
    <Version>1.0.0</Version>
    <!-- No company nor copyright in the properties of the exe. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <!-- No background garbage collection: the files are read in parallel, with many short-lived objects (the events of
         each file), and the build takes half the time without it (about 30 s instead of 70 for VGMusic). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerMIDI.Library\PowerMIDI.Library.csproj" />
  </ItemGroup>

  <!-- Descriptions of the known collections (source, names of the folders), next to the program. -->
  <ItemGroup>
    <None Include="Collections\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
