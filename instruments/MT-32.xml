				<Value />
				<Data>@CC 1 #VL</Data>
				<Memo>Vibrato depth.</Memo>
			</CCM>
			<CCM ID="7" Name="007 Volume" Color="#000099" Sync="Last">
				<Value Default="100" />
				<Data>@CC 7 #VL</Data>
				<Memo>Part volume.</Memo>
			</CCM>
			<CCM ID="10" Name="010 Panpot" Color="#CC0099" Sync="Last">
				<Value Default="64" TableID="4" />
				<Data>@CC 10 #VL</Data>
				<Memo>Stereo position, 64 = center. On an original MT-32 the direction is reversed compared with GM / GS.</Memo>
			</CCM>
			<CCM ID="11" Name="011 Expression" Color="#660099" Sync="Last">
				<Value Default="127" />
				<Data>@CC 11 #VL</Data>
				<Memo>Volume relative to CC7 Volume.</Memo>
			</CCM>
			<CCM ID="64" Name="064 Hold Pedal" Color="#333333">
				<Value TableID="1" />
				<Data>@CC 64 #VL</Data>
				<Memo>Sustain while ON (64-127).</Memo>
			</CCM>
			<CCM ID="121" Name="121 Reset All Controllers" Color="#333333">
				<Value>
					<Entry Label="  0   ON" Value="0" />
				</Value>
				<Data>@CC 121 #VL</Data>
				<Memo>Resets modulation, expression, hold pedal and pitch bend.</Memo>
			</CCM>
			<CCM ID="123" Name="123 All Notes Off" Color="#333333">
				<Value>
					<Entry Label="  0   ON" Value="0" />
				</Value>
				<Data>@CC 123 #VL</Data>
				<Memo>Releases all notes.</Memo>
			</CCM>
