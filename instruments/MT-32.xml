		<Folder Name="[128-] Other messages">
			<CCM ID="130" Name="130 Pitch Bend" Color="#800000" Sync="Last">
				<Value Min="-8192" Max="8191" Offset="8192" />
				<Data>@PB #VH #VL</Data>
				<Memo>Pitch change; the range is set by the patch (12 semitones by default).</Memo>
			</CCM>
			<CCM ID="140" Name="140 MT-32 Reset" Color="#000000">
				<Data>@SYSEX F0H 41H 10H 16H 12H 7FH 00H 00H 00H 01H F7H</Data>
				<Memo>All parameters reset: the module goes back to its power-on state. Leave time before the next message.</Memo>
			</CCM>
			<CCM ID="141" Name="141 Master Volume" Color="#CC00FF" Sync="Last">
				<Value Default="100" Max="100" />
				<Data>@SYSEX F0H 41H 10H 16H 12H [ 10H 00H 16H #VL ] F7H</Data>
				<Memo>System area 10 00 16: master volume, 0-100.</Memo>
			</CCM>
			<CCM ID="142" Name="142 Reverb Mode" Color="#006666">
				<Value Default="0" TableID="10" />
				<Data>@SYSEX F0H 41H 10H 16H 12H [ 10H 00H 01H #VL ] F7H</Data>
				<Memo>System area 10 00 01: Room, Hall, Plate or Tap Delay (the only effect of the MT-32).</Memo>
			</CCM>
			<CCM ID="143" Name="143 Reverb Time" Color="#006666">
				<Value Default="5" Max="7" />
				<Data>@SYSEX F0H 41H 10H 16H 12H [ 10H 00H 02H #VL ] F7H</Data>
				<Memo>System area 10 00 02: 0-7.</Memo>
			</CCM>
			<CCM ID="144" Name="144 Reverb Level" Color="#006666">
				<Value Default="3" Max="7" />
				<Data>@SYSEX F0H 41H 10H 16H 12H [ 10H 00H 03H #VL ] F7H</Data>
				<Memo>System area 10 00 03: 0-7.</Memo>
			</CCM>
