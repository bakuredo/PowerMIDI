		<Folder Name="[000-127] CC">
			<Folder Name="Basic (1, 7, 10, 11)">
				<CCM ID="1" Name="001 Modulation" Color="#0000CC" Sync="Last">
					<Value />
					<Data>@CC 1 #VL</Data>
					<Memo>Vibrato depth (pitch modulation).</Memo>
				</CCM>
				<CCM ID="7" Name="007 Volume" Color="#000099" Sync="Last">
					<Value Default="100" />
					<Data>@CC 7 #VL</Data>
					<Memo>Part volume (absolute). Use Expression for changes while notes are playing.</Memo>
				</CCM>
				<CCM ID="10" Name="010 Panpot" Color="#CC0099" Sync="Last">
					<Value Default="64" TableID="4" />
					<Data>@CC 10 #VL</Data>
					<Memo>Stereo position: 64 = center.</Memo>
				</CCM>
				<CCM ID="11" Name="011 Expression" Color="#660099" Sync="Last">
					<Value Default="127" />
					<Data>@CC 11 #VL</Data>
					<Memo>Volume relative to CC7 Volume, for changes while notes are playing.</Memo>
				</CCM>
			</Folder>
			<Folder Name="Hold Pedal (64)">
				<CCM ID="64" Name="064 Hold Pedal" Color="#333333">
					<Value TableID="1" />
					<Data>@CC 64 #VL</Data>
					<Memo>Sustain: notes keep sounding after Note Off while ON (64-127). Turn it OFF afterwards.</Memo>
				</CCM>
			</Folder>
			<Folder Name="Effects (91, 93)">
				<CCM ID="91" Name="091 Reverb" Color="#006666" Sync="Last">
					<Value Default="40" />
					<Data>@CC 91 #VL</Data>
					<Memo>Reverb send level (GM recommended practice, not part of GM level 1).</Memo>
				</CCM>
				<CCM ID="93" Name="093 Chorus" Color="#0066CC" Sync="Last">
					<Value />
					<Data>@CC 93 #VL</Data>
					<Memo>Chorus send level (GM recommended practice, not part of GM level 1).</Memo>
				</CCM>
			</Folder>
			<Folder Name="RPN (101, 100, 6, 38)">
				<CCM ID="101" Name="101 RPN MSB" Color="#006600">
					<Value>
						<Entry Label="  0     RPN" Value="0" />
						<Entry Label="127    Null" Value="127" />
					</Value>
					<Data>@CC 101 #VL</Data>
					<Memo>Selects an RPN with CC100, then CC6 (and CC38) set its value.</Memo>
				</CCM>
				<CCM ID="100" Name="100 RPN LSB" Color="#003300">
					<Value>
						<Entry Label="  0 Bend range" Value="0" />
						<Entry Label="  1 Fine tune" Value="1" />
						<Entry Label="  2 Coarse tune" Value="2" />
						<Entry Label="127    Null" Value="127" />
					</Value>
					<Data>@CC 100 #VL</Data>
					<Memo>Selects an RPN with CC101, then CC6 (and CC38) set its value.</Memo>
				</CCM>
				<CCM ID="6" Name="006 Data Entry MSB" Color="#996600">
					<Value />
					<Data>@CC 6 #VL</Data>
					<Memo>Value of the selected RPN.</Memo>
				</CCM>
				<CCM ID="38" Name="038 Data Entry LSB" Color="#996600">
					<Value />
					<Data>@CC 38 #VL</Data>
					<Memo>Fine value of the selected RPN.</Memo>
				</CCM>
			</Folder>
			<Folder Name="Channel Mode (120, 121, 123)">
				<CCM ID="120" Name="120 All Sound Off" Color="#333333">
					<Value>
						<Entry Label="  0   ON" Value="0" />
					</Value>
					<Data>@CC 120 #VL</Data>
					<Memo>Silences the channel immediately (GM2; widely supported).</Memo>
				</CCM>
				<CCM ID="121" Name="121 Reset All Controllers" Color="#333333">
					<Value>
						<Entry Label="  0   ON" Value="0" />
					</Value>
					<Data>@CC 121 #VL</Data>
					<Memo>Resets modulation, expression, hold pedal, pitch bend, channel pressure and the RPN selection.</Memo>
				</CCM>
				<CCM ID="123" Name="123 All Notes Off" Color="#333333">
					<Value>
						<Entry Label="  0   ON" Value="0" />
					</Value>
					<Data>@CC 123 #VL</Data>
					<Memo>Releases all notes (ignored while the hold pedal is ON).</Memo>
				</CCM>
			</Folder>
		</Folder>
		<Folder Name="[128-] Other messages">
			<Folder Name="Channel">
				<CCM ID="128" Name="128 Channel Pressure" Color="#660000" Sync="Last">
					<Value />
					<Data>@CP #VL</Data>
					<Memo>Channel aftertouch.</Memo>
				</CCM>
				<CCM ID="130" Name="130 Pitch Bend" Color="#800000" Sync="Last">
					<Value Min="-8192" Max="8191" Offset="8192" />
					<Data>@PB #VH #VL</Data>
					<Memo>Pitch change; its range is set by RPN Pitch Bend Sensitivity (CCM 151).</Memo>
				</CCM>
			</Folder>
			<Folder Name="RPN">
				<CCM ID="151" Name="151 Pitch Bend Sensitivity" Color="#800000">
					<Value Default="2" Max="24" Name="Semitones" />
					<Data>@RPN 0 0 #VL #NONE</Data>
					<Memo>Pitch bend range in semitones (GM default: 2).</Memo>
				</CCM>
				<CCM ID="152" Name="152 Fine Tuning" Color="#006600">
					<Value Min="-8192" Max="8191" Offset="8192" />
					<Data>@RPN 0 1 #VH #VL</Data>
					<Memo>Channel fine tuning: -8192..+8191 = -100..+100 cents.</Memo>
				</CCM>
				<CCM ID="153" Name="153 Coarse Tuning" Color="#006600">
					<Value Default="64" Min="40" Max="88" TableID="7" Name="Semitones" />
					<Data>@RPN 0 2 #VL #NONE</Data>
					<Memo>Channel transposition in semitones (64 = none).</Memo>
				</CCM>
				<CCM ID="154" Name="154 RPN Null" Color="#006600">
					<Data>@RPN 127 127 #NONE #NONE</Data>
					<Memo>Deselects the RPN, so that later Data Entry messages are ignored.</Memo>
				</CCM>
			</Folder>
			<Folder Name="System">
				<CCM ID="146" Name="146 GM System On" Color="#000000">
					<Data>@SYSEX F0H 7EH 7FH 09H 01H F7H</Data>
					<Memo>Resets the module to General MIDI. Leave about 100 ms before the next message.</Memo>
				</CCM>
				<CCM ID="148" Name="148 GM System Off" Color="#000000">
					<Data>@SYSEX F0H 7EH 7FH 09H 02H F7H</Data>
					<Memo>Leaves General MIDI mode (back to the module&apos;s own mode).</Memo>
				</CCM>
				<CCM ID="131" Name="131 Master Volume" Color="#CC00FF" Sync="Last">
					<Value Default="127" />
					<Data>@SYSEX F0H 7FH 7FH 04H 01H 00H #VL F7H</Data>
					<Memo>Universal SysEx Master Volume (all channels).</Memo>
				</CCM>
				<CCM ID="255" Name="255 Rest" Color="#6600CC">
					<Data></Data>
					<Memo>Rest: removed when exporting a standard MIDI file. Use it to space events.</Memo>
				</CCM>
			</Folder>
		</Folder>
